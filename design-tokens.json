  "shape": {
    "$comment": "Seelen radius.css 角色语义: xs=勾选框/小件, s=按钮/输入/列表项, m=卡片/弹层/菜单, l=对话框/整面板, full=胶囊",
    "radiusXs": 4,
    "radiusS": 6,
    "radiusM": 10,
    "radiusL": 16
  },
  "spacing": {
    "$comment": "Seelen spacings.css: xs 4 / s 8 / m 12 / l 16 / xl 20",
    "xs": 4,
    "s": 8,
    "m": 12,
    "l": 16,
    "xl": 20
  },
  "shadow": {
    "$comment": "KoBar 三级海拔: e1 卡片, e2 弹层, e3 模态; 恒配 1px 发丝描边",
    "e1": "0 2 3 #14000000",
    "e2": "0 4 12 #29000000",
    "e3": "0 8 28 #3D000000"
  },
  "indicator": {
    "$comment": "KoBar 选中态指示条: rail/导航激活项在贴屏侧的圆角竖条",
    "width": 3,
    "height": 18,
    "radius": 2
  },
  "touch": {
    "$comment": "触屏可达性：任意 UI 缩放下可交互元素的物理最小点击区（借鉴 CyreneCompass 的 32px 保底）",
    "minHitPx": 32
  },
  "m3": {
    "$comment": "Material Design 3 + mochi-compose 设计规格（2026-11）。mochi 为 Android Compose 库，此处只移植规格数值，不复用其代码。形状/动效数值对齐 mochi-compose 的 MochiShapes 与 MochiMotionTokens；色彩为 MD3 seed #2B6EE0 的标准 tonal 映射。",
    "shape": {
      "extraSmall": 4,
      "small": 8,
      "medium": 12,
      "large": 16,
      "largeIncreased": 20,
      "extraLarge": 28,
      "extraLargeIncreased": 32,
      "extraExtraLarge": 48,
      "full": 999
    },
    "spacing": {
      "xs": 4,
      "s": 8,
      "m": 12,
      "l": 16,
      "xl": 24,
      "xxl": 32
    },
    "touch": {
      "$comment": "MD3 最小触控目标 48dp；mochi 规范要求 >=44dp。取 44 作硬下限、48 作默认控件高。",
      "minTargetDip": 48,
      "minTouchDip": 44
    },
    "elevation": {
      "level0": "0 0 0 0 #00000000",
      "level1": "0 1 2 0 #1F000000, 0 1 3 1 #14000000",
      "level2": "0 1 2 0 #1F000000, 0 2 6 2 #14000000",
      "level3": "0 4 8 3 #1F000000, 0 1 3 0 #14000000",
      "level4": "0 6 10 4 #1F000000, 0 2 3 0 #14000000",
      "level5": "0 8 12 6 #1F000000, 0 4 6 0 #14000000"
    },
    "motion": {
      "$comment": "对齐 mochi MochiMotionTokens：response(秒)+damping 为原始规格；ms/easing 是 Avalonia 无物理弹簧时的等效实现（damping<1 用过冲缓动近似）。",
      "page": {
        "responseSec": 0.42,
        "damping": 1.0,
        "ms": 420,
        "easing": "CubicEaseOut"
      },
      "present": {
        "responseSec": 0.42,
        "damping": 0.86,
        "ms": 420,
        "easing": "BackEaseOut"
      },
      "pop": {
        "responseSec": 0.36,
        "damping": 0.78,
        "ms": 360,
        "easing": "BackEaseOut"
      },
      "control": {
        "responseSec": 0.34,
        "damping": 0.86,
        "ms": 340,
        "easing": "CubicEaseOut"
      },
      "settle": {
        "responseSec": 0.28,
        "damping": 1.0,
        "ms": 280,
        "easing": "CubicEaseOut"
      },
      "bounce": {
        "responseSec": 0.34,
        "damping": 0.55,
        "ms": 340,
        "easing": "BackEaseOut"
      },
      "pressDown": {
        "responseSec": 0.22,
        "damping": 0.62,
        "ms": 220,
        "easing": "CubicEaseOut"
      },
      "pressRelease": {
        "responseSec": 0.38,
        "damping": 0.62,
        "ms": 380,
        "easing": "BackEaseOut"
      },
      "fade": {
        "responseSec": 0.15,
        "damping": 1.0,
        "ms": 150,
        "easing": "CubicEaseOut"
      },
      "fadeOut": {
        "responseSec": 0.12,
        "damping": 1.0,
        "ms": 120,
        "easing": "CubicEaseIn"
      }
    },
    "typography": {
      "$comment": "MD3 type scale（size/lineHeight/weight/letterSpacing 单位 dip）。字体族由 MiSansFont.axaml 统一提供。",
