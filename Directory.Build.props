<Project>
  <!-- Wave A 骨架: 代码风格约定见 docs/project_rules.md (file-scoped ns / sealed / nullable 全开) -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>1.8.0</Version>
  </PropertyGroup>

  <!-- 生成物/非源码目录不进 Compile/None 项，避免打包产物与历史快照被误收进工程
       （借鉴 VeriRandom 的 DefaultItemExcludes 做法） -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;dist/**;publish/**;node_modules/**</DefaultItemExcludes>
    <DefaultItemExcludes>$(DefaultItemExcludes);installer/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- 构建可复现性：符号带源码映射，崩溃 dump 可回溯到具体提交
       （借鉴 VeriRandom 的 Global.props：SourceLink + CI 构建标记 + 调试符号） -->
  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.102" PrivateAssets="All" />
    <!-- 传递包钉修版: GHSA-23fw-v26w-5fgq (NTLM 凭据泄漏), 8.0.x/10.0.102 仍在受影响列表 -->
    <PackageReference Include="Microsoft.Build.Tasks.Git" Version="10.0.403" PrivateAssets="All" />
  </ItemGroup>

  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
