<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartSideBAR.Avalonia.ViewModels"
        xmlns:svgc="using:Avalonia.Svg.Skia"
        x:Class="SmartSideBAR.Avalonia.Views.SidebarWindow"
        x:DataType="vm:SidebarViewModel"
        Title="SmartSideBAR"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        Width="52" Height="800">

  <Window.Styles>
    <Style Selector="Button.railBtn">
      <Style.Setters>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="44"/>
        <Setter Property="Height" Value="44"/>
        <Setter Property="CornerRadius" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.railBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#14FFFFFF"/>
    </Style>
    <Style Selector="Button.railBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#28FFFFFF"/>
    </Style>
    <Style Selector="Button.linkBtn">
      <Style.Setters>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#111111"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.linkBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#0F2B6EE0"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- ====== 常规形态: 液态玻璃胶囊 (v1.1 v7配方: blur21 saturate2.2 + radial tint + 边光环) ====== -->
    <Border IsVisible="{Binding !IsDocked}" CornerRadius="28"
            BoxShadow="0 12 40 #40000000, 0 0 0 0.5 #80FFFFFF, 0 1 3 #40FFFFFF"
            VerticalAlignment="Stretch" Margin="0,48,0,48">
      <!-- v1.1 v7: radial-gradient at 18% 0% 白色高光 + linear 143deg 半透明白底 -->
      <Border.Background>
        <LinearGradientBrush StartPoint="18%,0%" EndPoint="82%,100%">
          <GradientStop Color="#9EFFFFFF" Offset="0"/>
          <GradientStop Color="#66FFFFFF" Offset="0.46"/>
          <GradientStop Color="#47FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <!-- v1.1 v7 边光环: 1.5px 白色渐变环 (mask-composite exclude 在 Avalonia 用 BorderBrush 近似) -->
      <Border BorderThickness="1.5" CornerRadius="28">
        <Border.BorderBrush>
          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
            <GradientStop Color="#D9FFFFFF" Offset="0"/>
            <GradientStop Color="#47FFFFFF" Offset="0.18"/>
            <GradientStop Color="#14FFFFFF" Offset="0.4"/>
            <GradientStop Color="#29FFFFFF" Offset="0.62"/>
            <GradientStop Color="#99FFFFFF" Offset="1"/>
          </LinearGradientBrush>
        </Border.BorderBrush>
        <DockPanel Margin="0,8,0,6">
          <!-- dock 切换 (v1.1: ↓ 收起到底部小方块; docked 后 ↑ 展开) -->
          <Button Classes="railBtn" DockPanel.Dock="Bottom" Command="{Binding DockCommand}" ToolTip.Tip="{Binding DockTooltip}">
            <Path Data="{Binding DockArrowPath}"
                  Stroke="#333333" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                  Width="24" Height="24" Stretch="Uniform"/>
          </Button>
          <ScrollViewer Padding="0,2">
            <StackPanel HorizontalAlignment="Center" Spacing="6">
              <Button Classes="railBtn" Command="{Binding ToggleImeCommand}" ToolTip.Tip="输入法切换">
                <Panel>
                  <Image Width="22" Height="22" Tag="svg:ime"/>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          CornerRadius="6" Background="#2B6EE0" Padding="3,1">
                    <TextBlock Text="{Binding ImeState}" FontSize="9" Foreground="White"/>
                  </Border>
                </Panel>
              </Button>
              <Button Classes="railBtn" Command="{Binding CaptureCommand}" ToolTip.Tip="区域截图">
                <Image Width="22" Height="22" Tag="svg:capture"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding AnnotateCommand}" ToolTip.Tip="批注">
                <Image Width="22" Height="22" Tag="svg:annotate"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding LongshotCommand}" ToolTip.Tip="长截图">
                <Image Width="22" Height="22" Tag="svg:longshot"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding RecordCommand}" ToolTip.Tip="录屏 (MP4)">
                <Image Width="22" Height="22" Tag="svg:record"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding UsbCommand}" ToolTip.Tip="USB 监控">
                <Image Width="22" Height="22" Tag="svg:usb"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding PrinterCommand}" ToolTip.Tip="打印机">
                <Image Width="22" Height="22" Tag="svg:printer"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding OpenTaskMgrCommand}" ToolTip.Tip="任务管理器">
                <Image Width="22" Height="22" Tag="svg:taskmgr"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding TogglePanelCommand}" ToolTip.Tip="快捷链接">
                <Image Width="22" Height="22" Tag="svg:link"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding ReminderCommand}" ToolTip.Tip="定时提醒">
                <Image Width="22" Height="22" Tag="svg:bell"/>
              </Button>
              <Button Classes="railBtn" Command="{Binding SettingsCommand}" ToolTip.Tip="设置">
                <Image Width="22" Height="22" Tag="svg:settings"/>
              </Button>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Border>

    <!-- 展开面板: 白底蓝字 (仅常规形态) -->
    <Border IsVisible="{Binding PanelOpen}" HorizontalAlignment="Right" Width="380"
            Background="#FFFFFF" CornerRadius="0,16,16,0" Padding="18,14" BoxShadow="-4 0 20 #1A000000">
      <StackPanel Spacing="8">
        <TextBlock Text="快捷链接" FontSize="16" FontWeight="SemiBold" Foreground="#1A1A1A"/>
        <ItemsControl ItemsSource="{Binding Links}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="linkBtn" Margin="0,0,0,4"
                      Command="{Binding $parent[Window].((vm:SidebarViewModel)DataContext).OpenLinkCommand}"
                      CommandParameter="{Binding}">
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
  </Panel>
</Window>
