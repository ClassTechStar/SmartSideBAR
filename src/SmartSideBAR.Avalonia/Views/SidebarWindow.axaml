<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartSideBAR.Avalonia.ViewModels"
        xmlns:svgc="using:Avalonia.Svg.Skia"
        x:Class="SmartSideBAR.Avalonia.Views.SidebarWindow"
        x:DataType="vm:SidebarViewModel"
        Title="SmartSideBAR"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur"
        Width="72" Height="800">

  <Window.Styles>
    <Style Selector="Button.railBtn">
      <Style.Setters>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.railBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#140F172A"/>
    </Style>
    <Style Selector="Button.railBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="#210F172A"/>
    </Style>
    <Style Selector="Button.railBtn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="#210F172A"/>
    </Style>
    <Style Selector="Button.linkBtn">
      <Style.Setters>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#2B6EE0"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="BorderBrush" Value="#382B6EE0"/>
        <Setter Property="BorderThickness" Value="1"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.linkBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F0F4FB"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- ====== 悬浮态: 液态玻璃胶囊 (v1.2 v7: radial tint + linear gradient + blur21 saturate2.2 + 边光环) ====== -->
    <!-- AppBar 已按工作区 84% 高度定位 (上下各留 8%), 此处不再加额外边距 -->
    <Border IsVisible="{Binding !IsDocked}" CornerRadius="28"
            BoxShadow="0 12 40 #40000000, 0 0 0 0.5 #80FFFFFF, 0 1 3 #40FFFFFF"
            Width="72" HorizontalAlignment="Right"
            VerticalAlignment="Stretch">
      <!-- v1.2 v7: linear-gradient(143deg, rgba(255,255,255,0.62) 0%, rgba(255,255,255,0.4) 46%, rgba(255,255,255,0.28) 100%) -->
      <Border.Background>
        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
          <GradientStop Color="#9EFFFFFF" Offset="0"/>
          <GradientStop Color="#66FFFFFF" Offset="0.46"/>
          <GradientStop Color="#47FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <!-- v1.2 v7: radial-gradient(120% 90% at 18% 0%, rgba(255,255,255,0.5) 0%, rgba(255,255,255,0.14) 42%, transparent 68%) -->
        <Rectangle>
          <Rectangle.Fill>
            <RadialGradientBrush Center="0.18,0" RadiusX="1.2" RadiusY="0.9">
              <GradientStop Color="#80FFFFFF" Offset="0"/>
              <GradientStop Color="#24FFFFFF" Offset="0.42"/>
              <GradientStop Color="#00FFFFFF" Offset="0.68"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <!-- v1.2 v7 边光环: 1.5px 白色渐变环 -->
        <Border BorderThickness="1.5" CornerRadius="28">
          <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Color="#D9FFFFFF" Offset="0"/>
              <GradientStop Color="#47FFFFFF" Offset="0.18"/>
              <GradientStop Color="#14FFFFFF" Offset="0.4"/>
              <GradientStop Color="#29FFFFFF" Offset="0.62"/>
              <GradientStop Color="#99FFFFFF" Offset="1"/>
            </LinearGradientBrush>
          </Border.BorderBrush>
          <!-- v1.2: rail padding 12px top, 8px bottom -->
          <DockPanel Margin="0,12,0,8">
            <!-- dock 切换 (v1.2: 圆形玻璃钮, 白色渐变底 v6) -->
            <Button Classes="railBtn" DockPanel.Dock="Bottom" Command="{Binding DockCommand}" ToolTip.Tip="{Binding DockTooltip}">
              <Button.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#C7FFFFFF" Offset="0"/>
                  <GradientStop Color="#73FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Button.Background>
              <Path Data="{Binding DockArrowPath}"
                    Stroke="#333333" StrokeThickness="2" StrokeLineCap="Round" StrokeJoin="Round"
                    Width="24" Height="24" Stretch="Uniform"/>
            </Button>
            <ScrollViewer Padding="0,2">
              <StackPanel HorizontalAlignment="Center" Spacing="6">
                <Button Classes="railBtn" Command="{Binding ToggleImeCommand}" ToolTip.Tip="输入法切换">
                  <Panel>
                    <Image Width="28" Height="28" Tag="svg:ime"/>
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            CornerRadius="8" Width="16" Height="16" Background="#D1FFFFFF" Padding="0">
                      <TextBlock Text="{Binding ImeState}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="#2A2F38" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                  </Panel>
                </Button>
                <Button Classes="railBtn" Command="{Binding CaptureCommand}" ToolTip.Tip="区域截图">
                  <Image Width="28" Height="28" Tag="svg:capture"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding AnnotateCommand}" ToolTip.Tip="批注">
                  <Image Width="28" Height="28" Tag="svg:annotate"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding LongshotCommand}" ToolTip.Tip="长截图">
                  <Image Width="28" Height="28" Tag="svg:longshot"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding RecordCommand}" ToolTip.Tip="录屏 (MP4)">
                  <Image Width="28" Height="28" Tag="svg:record"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding UsbCommand}" ToolTip.Tip="USB 监控">
                  <Image Width="28" Height="28" Tag="svg:usb"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding PrinterCommand}" ToolTip.Tip="打印机">
                  <Image Width="28" Height="28" Tag="svg:printer"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding OpenTaskMgrCommand}" ToolTip.Tip="任务管理器">
                  <Image Width="28" Height="28" Tag="svg:taskmgr"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding TogglePanelCommand}" ToolTip.Tip="快捷链接">
                  <Image Width="28" Height="28" Tag="svg:link"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding ReminderCommand}" ToolTip.Tip="定时提醒">
                  <Image Width="28" Height="28" Tag="svg:bell"/>
                </Button>
                <Button Classes="railBtn" Command="{Binding SettingsCommand}" ToolTip.Tip="设置">
                  <Image Width="28" Height="28" Tag="svg:settings"/>
                </Button>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- 展开面板: 纯白底 + 品牌蓝文字 (v1.2 panel-contrast.css 覆写) -->
    <!-- panel-contrast.css: background:#FFFFFF !important; color:#2B6EE0 !important; border-radius:28px -->
    <Border IsVisible="{Binding PanelOpen}" HorizontalAlignment="Left" Width="380"
            CornerRadius="28" Background="White"
            BoxShadow="0 12 40 #40000000">
      <DockPanel>
        <!-- v1.2 panel-header: height 52, border-bottom 1px rgba(0,0,0,0.07) -->
        <Border DockPanel.Dock="Top" Height="52" Padding="16,0"
                BorderBrush="#12000000" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="快捷链接" FontSize="15" FontWeight="SemiBold"
                       Foreground="#2B6EE0" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="linkBtn" Width="32" Height="32" Padding="0"
                    CornerRadius="10" HorizontalAlignment="Center" HorizontalContentAlignment="Center"
                    Command="{Binding TogglePanelCommand}" ToolTip.Tip="关闭面板">
              <TextBlock Text="×" FontSize="20" Foreground="#2B6EE0"/>
            </Button>
          </Grid>
        </Border>
        <!-- v1.2 panel-body: padding 12,16, color #2B6EE0 -->
        <ScrollViewer Padding="16,12">
          <ItemsControl ItemsSource="{Binding Links}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Classes="linkBtn" Margin="0,0,0,4"
                        Command="{Binding $parent[Window].((vm:SidebarViewModel)DataContext).OpenLinkCommand}"
                        CommandParameter="{Binding}">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Panel>
</Window>
