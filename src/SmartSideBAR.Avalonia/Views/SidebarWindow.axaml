<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SmartSideBAR.Avalonia.ViewModels"
        x:Class="SmartSideBAR.Avalonia.Views.SidebarWindow"
        x:DataType="vm:SidebarViewModel"
        Title="SmartSideBAR"
        SystemDecorations="None"
        ShowInTaskbar="False"
        CanResize="False"
        ShowActivated="False"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Width="72" Height="800">

  <Window.Resources>
    <!-- 主题色由 Theme.cs 计算后写入, 样式用 DynamicResource 引用, 切换主题即时生效 -->
    <SolidColorBrush x:Key="RailHover" Color="#140F172A"/>
    <SolidColorBrush x:Key="RailPressed" Color="#210F172A"/>
    <SolidColorBrush x:Key="RailActive" Color="#262B6EE0"/>
    <SolidColorBrush x:Key="BadgeBg" Color="#D1FFFFFF"/>
    <SolidColorBrush x:Key="BadgeFg" Color="#2A2F38"/>
  </Window.Resources>

  <Window.Styles>
    <Style Selector="Button.railBtn">
      <Style.Setters>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="52"/>
        <Setter Property="Height" Value="52"/>
        <Setter Property="CornerRadius" Value="26"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.railBtn:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RailHover}"/>
    </Style>
    <Style Selector="Button.railBtn:pressed /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RailPressed}"/>
    </Style>
    <Style Selector="Button.railBtn.active /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RailActive}"/>
    </Style>
    <Style Selector="Button.panelClose">
      <Style.Setters>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
      </Style.Setters>
    </Style>
    <Style Selector="Button.panelClose:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource RailHover}"/>
    </Style>
  </Window.Styles>

  <Panel>
    <!-- ====== 悬浮态: 液态玻璃胶囊 ====== -->
    <Border x:Name="RailCapsule" IsVisible="{Binding !IsDocked}" CornerRadius="28"
            BoxShadow="0 12 40 #40000000, 0 0 0 0.5 #80FFFFFF, 0 1 3 #40FFFFFF"
            Width="72" HorizontalAlignment="Right" VerticalAlignment="Stretch">
      <Grid>
        <Rectangle x:Name="RailGlowRect"/>
        <!-- 液态玻璃高光层: 镜面高光跟随光标 + R/G/B 色散内描边 -->
        <Canvas x:Name="RailSheen" IsHitTestVisible="False"/>
        <!-- 边光环 -->
        <Border x:Name="RailRim" BorderThickness="1.5" CornerRadius="28">
          <DockPanel Margin="0,12,0,8">
            <!-- dock 切换 -->
            <Button x:Name="DockBtn" Classes="railBtn" DockPanel.Dock="Bottom"
                    HorizontalAlignment="Center" Margin="0,0,0,6"
                    Command="{Binding DockCommand}" ToolTip.Tip="{Binding DockTooltip}">
              <!-- 尺寸由 DesignTokens.Dock.ArrowSizePx 在构造时写入（单一真源） -->
              <Image x:Name="DockArrowIcon" Width="30" Height="30" Source="{Binding DockIcon}"/>
            </Button>

            <ScrollViewer Padding="0,2" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding RailItems}" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="6" HorizontalAlignment="Center"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RailItem">
                    <Button Classes="railBtn" Classes.active="{Binding IsActive}"
                            Command="{Binding Command}" ToolTip.Tip="{Binding Title}">
                      <Panel>
                        <Image Width="28" Height="28" Source="{Binding Icon}">
                          <Image.Effect>
                            <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="2" Opacity="0.18" Color="Black"/>
                          </Image.Effect>
                        </Image>
                        <Border IsVisible="{Binding HasBadge}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,2,2" CornerRadius="6" Padding="4,1"
                                Background="{DynamicResource BadgeBg}">
                          <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="SemiBold"
                                     Foreground="{DynamicResource BadgeFg}"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </Panel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Border>

    <!-- ====== 展开面板 ====== -->
    <Border x:Name="PanelHost" IsVisible="{Binding PanelOpen}" HorizontalAlignment="Left" Width="380"
            CornerRadius="28" BoxShadow="0 12 40 #40000000">
      <Grid>
        <!-- 高光层置于内容之下，避免白色叠加冲淡文字 -->
        <Canvas x:Name="PanelSheen" IsHitTestVisible="False"/>
        <DockPanel>
        <Border x:Name="PanelHeader" DockPanel.Dock="Top" Height="52" Padding="16,0"
                BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="PanelTitleText" Grid.Column="0" Text="{Binding PanelTitle}"
                       FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Classes="panelClose" Command="{Binding ClosePanelCommand}"
                    ToolTip.Tip="关闭面板">
              <TextBlock x:Name="PanelCloseGlyph" Text="×" FontSize="20"/>
            </Button>
          </Grid>
        </Border>
        <ScrollViewer x:Name="PanelScroll" Padding="16,12" HorizontalScrollBarVisibility="Disabled">
          <ContentControl x:Name="PanelBody" HorizontalContentAlignment="Stretch"/>
        </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
  </Panel>
</Window>
