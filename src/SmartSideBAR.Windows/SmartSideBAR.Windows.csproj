<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 互操作层: Win32 P/Invoke 收敛于此; 不引用任何 UI 框架
       (AppBarService 只吃 hwnd, 由上层传入 —— 便于假件注入单测) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SmartSideBAR.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <InternalsVisibleTo Include="SmartSideBAR.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartSideBAR.Core\SmartSideBAR.Core.csproj" />
  </ItemGroup>

</Project>
