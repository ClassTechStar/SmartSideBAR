<Project Sdk="Microsoft.NET.Sdk">

  <!-- Windows 互操作层: Win32 P/Invoke 收敛于此; 不引用任何 UI 框架
       (AppBarService 只吃 hwnd, 由上层传入 —— 便于假件注入单测) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <RootNamespace>SmartSideBAR.Windows</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <InternalsVisibleTo Include="SmartSideBAR.Windows.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SmartSideBAR.Core\SmartSideBAR.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 发布包裁剪会把 System.Management 的 WbemDefPath 无参构造裁掉 (反射创建失败),
         USB WMI / 打印机轮询在安装包里全灭而开发态正常 (2026-11 审计实测)。
         根治: 整程序集保留。体积代价 ~1MB, 换回 USB/打印机功能。 -->
    <TrimmerRootAssembly Include="System.Management" />
  </ItemGroup>
</Project>
